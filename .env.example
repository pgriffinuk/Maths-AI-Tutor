# Copy this file to .env.local and fill in real values - .env.local is
# gitignored and never committed. Set the same variables in your Vercel
# project's Environment Variables for production/preview deploys.

# Anthropic API key, used server-side by lib/claude.js for every AI
# generation/marking route.
ANTHROPIC_API_KEY=

# Supabase project. The anon key is safe to expose to the browser (it's
# subject to Row Level Security); the service role key is server-only and
# bypasses RLS entirely - never let it reach the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating the free public /chatbot page and its
# /api/anon-chat route - this is cost control (keeping random internet
# visitors from running up API usage), not personal data protection, so a
# single shared password is enough. Checked server-side in
# /api/anon-chat/route.js before any rate-limit check or AI call.
CHATBOT_ACCESS_PASSWORD=
